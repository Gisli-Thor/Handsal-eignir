generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Vertical {
  EIGNIR
  BILAR
}

enum Role {
  SUPERADMIN
  ADMIN
  AGENT
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Plan {
  id                String   @id @default(cuid())
  name              String   @unique
  /// null = unlimited active listings
  maxActiveListings Int?
  monthlyPriceISK   Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenants Tenant[]
}

enum ContactType {
  PERSON
  COMPANY
}

enum ListingContactRole {
  SELLER
  BUYER
  PROSPECTIVE_BUYER
  CO_OWNER
}

enum PropertyType {
  FJOLBYLI
  EINBYLI
  RADHUS
  PARHUS
  HAED
  ATVINNUHUSNAEDI
  SUMARHUS
  LOD
  ANNAD
}

/// Bílskúr / bílastæði (SPEC §5 "bílskúr/bílastæði (enum + count)")
enum ParkingType {
  NONE
  BILSKUR
  BILSKYLI
  STAEDI
  STAEDI_I_BILAHUSI
}

enum MediaCategory {
  PHOTO
  FLOOR_PLAN
  DOCUMENT_SCAN
}

// ── M3: pipeline, offers, fyrirvarar, activity ───────────────────────────────

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  WITHDRAWN
}

enum FyrirvariType {
  FJARMOGNUN
  SALA_EIGIN_EIGNAR
  ASTANDSSKODUN
  SAMTHYKKI_STJORNAR
  ANNAD
}

enum FyrirvariStatus {
  PENDING
  FULFILLED
  WAIVED
  FAILED
}

/// Which side of the deal is responsible for resolving a fyrirvari.
enum PartySide {
  BUYER
  SELLER
}

enum ViewingKind {
  SKODUN
  OPID_HUS
}

enum ListingDocumentType {
  EIGNASKIPTAYFIRLYSING
  SKILALYSING
  VEDBANDAYFIRLIT
  ANNAD
}

model Tenant {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  vertical   Vertical
  logoUrl    String?
  brandColor String?
  email      String?
  phone      String?
  address    String?
  status     TenantStatus @default(ACTIVE)
  planId     String
  plan       Plan         @relation(fields: [planId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  users            User[]
  auditLogs        AuditLog[]
  contacts Contact[]
  listings Listing[]
}

model User {
  id           String   @id @default(cuid())
  /// null = platform-level SUPERADMIN (belongs to no tenant)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role
  avatarUrl    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs          AuditLog[]
  listingAssignments ListingAgent[]
  taskAssignments    ListingTask[]

  // Composite target for tenant-safe FKs (ListingAgent etc.)
  @@unique([tenantId, id])
  @@index([tenantId])
}

/// Append-only. Never expose update or delete paths for this model.
/// `action` is a string validated against the AuditAction union in
/// src/core/audit/actions.ts so new actions don't require a migration.
model AuditLog {
  id          String   @id @default(cuid())
  /// null = platform-level event (superadmin actions)
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([action])
}

/// Global reference data (Icelandic postal codes → locality + municipality,
/// SPEC §5). Carries no tenant data; read through unscopedDb.
model PostalCode {
  /// e.g. "101"
  code         String @id
  /// Staður, e.g. "Reykjavík"
  locality     String
  /// Sveitarfélag, e.g. "Reykjavíkurborg"
  municipality String

  properties Property[]
}

/// CRM-lite contact (SPEC §4). Contacts never log in.
model Contact {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  type      ContactType
  /// Normalized to 10 digits, checksum-validated when present
  kennitala String?
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  tags      String[]    @default([])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  listingLinks       ListingContact[]
  offerLinks         OfferBuyer[]
  viewingAttendances ViewingAttendee[]

  @@unique([tenantId, kennitala])
  // Composite target for tenant-safe FKs (ListingContact)
  @@unique([tenantId, id])
  @@index([tenantId, name])
}

/// Core listing base (SPEC §5) — shared by both verticals. Vertical-specific
/// fields live on Property (Eignir) / Vehicle (Bílar, M6).
model Listing {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  vertical Vertical
  /// Pipeline stage key — configuration data per vertical (SPEC §6). The
  /// pipeline engine (M3) is the only writer once it lands.
  stage    String   @default("UNDIRBUNINGUR")
  /// Ásett verð. BigInt: commercial property prices exceed int4.
  askingPriceISK BigInt?
  descriptionIs  String?
  descriptionEn  String?
  publishedAt    DateTime?
  soldAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  agents    ListingAgent[]
  contacts  ListingContact[]
  property  Property?
  loans     EncumbranceLoan[]
  media     MediaAsset[]
  documents ListingDocument[]

  stageTransitions StageTransition[]
  offers           Offer[]
  viewings         Viewing[]
  notes            ListingNote[]
  tasks            ListingTask[]

  // Composite target for tenant-safe FKs: child rows reference
  // (tenantId, id) so a row can never point at another tenant's listing,
  // even if application code slips.
  @@unique([tenantId, id])
  @@index([tenantId, stage])
  @@index([tenantId, createdAt])
}

/// Responsible agent(s) on a listing. Composite FKs pin both the listing and
/// the user to the row's own tenant.
model ListingAgent {
  id        String  @id @default(cuid())
  tenantId  String
  listingId String
  listing   Listing @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [tenantId, userId], references: [tenantId, id])
  isPrimary Boolean @default(false)

  @@unique([listingId, userId])
  @@index([tenantId, userId])
}

/// Contextual contact role per listing (SPEC §4): seljandi, kaupandi,
/// áhugasamur kaupandi, co-owner.
model ListingContact {
  id        String             @id @default(cuid())
  tenantId  String
  listingId String
  listing   Listing            @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)
  contactId String
  contact   Contact            @relation(fields: [tenantId, contactId], references: [tenantId, id])
  role      ListingContactRole
  createdAt DateTime           @default(now())

  @@unique([listingId, contactId, role])
  @@index([tenantId, contactId])
}

/// Handsal Eignir property extension (SPEC §5) — 1:1 with a Listing.
model Property {
  id        String  @id @default(cuid())
  tenantId  String
  listingId String  @unique
  listing   Listing @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)

  fastanumer      String
  landeignarnumer String?

  gotuheiti  String
  husnumer   String
  /// Íbúð / merking
  ibud       String?
  postnumer  String
  postalCode PostalCode @relation(fields: [postnumer], references: [code])

  tegund PropertyType

  /// Birt stærð, m² one decimal
  birtStaerd    Decimal? @db.Decimal(7, 1)
  /// Þar af geymsla, m²
  tharAfGeymsla Decimal? @db.Decimal(7, 1)

  herbergi      Int?
  svefnherbergi Int?
  badherbergi   Int?

  /// Hæð (floor)
  haed         Int?
  lyfta        Boolean     @default(false)
  parkingType  ParkingType @default(NONE)
  parkingCount Int?
  byggingarar  Int?

  fasteignamatISK BigInt?
  brunabotamatISK BigInt?

  /// Notes / condition remarks
  athugasemdir String?

  @@unique([tenantId, listingId])
  @@index([tenantId, fastanumer])
  @@index([tenantId, postnumer])
}

/// Áhvílandi lán (SPEC §5). On the Listing so the Bílar vertical (M6) reuses
/// the same structure.
model EncumbranceLoan {
  id        String  @id @default(cuid())
  tenantId  String
  listingId String
  listing   Listing @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)

  lender              String
  remainingBalanceISK BigInt
  /// Verðtryggt (true) / óverðtryggt (false)
  verdtryggt          Boolean  @default(false)
  /// Annual interest rate in percent, e.g. 4.25
  interestRatePct     Decimal? @db.Decimal(5, 2)
  /// Yfirtakanlegt (assumable)
  yfirtakanlegt       Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([tenantId, listingId])
}

/// Photo / floor plan / document scan in object storage (SPEC §5 Media).
/// Binaries live in S3; rows hold keys only.
model MediaAsset {
  id        String        @id @default(cuid())
  tenantId  String
  listingId String
  listing   Listing       @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)
  category  MediaCategory

  /// Original upload
  storageKey String
  /// Web-size derivative (generated server-side on upload)
  webKey     String?
  /// Thumbnail derivative
  thumbKey   String?

  filename    String
  contentType String
  sizeBytes   Int
  width       Int?
  height      Int?

  sortOrder    Int
  isCover      Boolean  @default(false)
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([tenantId, listingId, sortOrder])
}

/// Typed, dated document on a listing (SPEC §5 Documents):
/// eignaskiptayfirlýsing, skilalýsing, veðbandayfirlit, free-form.
model ListingDocument {
  id        String              @id @default(cuid())
  tenantId  String
  listingId String
  listing   Listing             @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)
  type      ListingDocumentType
  title     String
  /// Dagsetning skjals (not the upload time)
  documentDate DateTime?

  storageKey  String
  filename    String
  contentType String
  sizeBytes   Int

  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([tenantId, listingId])
}

// ── M3: pipeline, offers, fyrirvarar, activity ───────────────────────────────

/// Full stage history (SPEC §6): every transition with timestamps and actor.
/// Append-only — written exclusively by the pipeline engine.
model StageTransition {
  id        String  @id @default(cuid())
  tenantId  String
  listingId String
  listing   Listing @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)

  /// null on the initial (creation) entry
  fromStage String?
  toStage   String
  /// null = system transition (offer acceptance side-effect, jobs)
  actorUserId String?
  /// Fallið frá reason, or the ADMIN's reason when a guard was overridden
  reason      String?
  /// True when an overridable guard was bypassed by an ADMIN (audited)
  overridden  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId, listingId, createdAt])
}

/// Kauptilboð / gagntilboð (SPEC §7). A counter references its parent —
/// offers on a listing form chains; parentId null = chain root (kauptilboð).
model Offer {
  id        String  @id @default(cuid())
  tenantId  String
  listingId String
  listing   Listing @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)

  parentId String?
  parent   Offer?  @relation("OfferChain", fields: [tenantId, parentId], references: [tenantId, id])
  counters Offer[] @relation("OfferChain")

  amountISK BigInt
  /// Proposed afhending (handover) date
  afhendingDate DateTime?
  /// Gildistími — the offer is binding until this timestamp, then expires
  gildistimi DateTime
  /// Free-text terms
  terms      String?
  status     OfferStatus @default(PENDING)

  /// Agent who registered the offer
  createdById String?
  /// Who/when decided (accept/reject/withdraw); expiry leaves these null
  decidedById String?
  decidedAt   DateTime?
  /// Immutable copy of the accepted terms, written at acceptance (SPEC §7)
  acceptedSnapshot Json?

  buyers       OfferBuyer[]
  paymentItems OfferPaymentItem[]
  fyrirvarar   Fyrirvari[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite target for tenant-safe child FKs and the self-relation
  @@unique([tenantId, id])
  @@index([tenantId, listingId, createdAt])
  @@index([tenantId, status, gildistimi])
}

/// Buyer contact(s) on an offer, with optional ownership share (real offers
/// routinely split ownership, e.g. 54%/46% — see examples/NOTES.md).
model OfferBuyer {
  id        String  @id @default(cuid())
  tenantId  String
  offerId   String
  offer     Offer   @relation(fields: [tenantId, offerId], references: [tenantId, id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [tenantId, contactId], references: [tenantId, id])
  /// Eignarhlutur in percent; null = unspecified/equal
  sharePct  Decimal? @db.Decimal(5, 2)

  @@unique([offerId, contactId])
  @@index([tenantId, contactId])
}

/// Greiðslutilhögun line item (SPEC §7): description, amount, due date.
/// The items of an offer must sum to the offer amount (validated in core).
model OfferPaymentItem {
  id       String @id @default(cuid())
  tenantId String
  offerId  String
  offer    Offer  @relation(fields: [tenantId, offerId], references: [tenantId, id], onDelete: Cascade)

  description String
  amountISK   BigInt
  dueDate     DateTime?
  sortOrder   Int

  @@index([tenantId, offerId, sortOrder])
}

/// Fyrirvari — typed condition on an (accepted) offer (SPEC §7).
model Fyrirvari {
  id       String @id @default(cuid())
  tenantId String
  offerId  String
  offer    Offer  @relation(fields: [tenantId, offerId], references: [tenantId, id], onDelete: Cascade)

  type        FyrirvariType
  description String
  deadline    DateTime
  /// Which side must resolve it
  responsible PartySide
  status      FyrirvariStatus @default(PENDING)

  resolvedById String?
  resolvedAt   DateTime?

  /// Reminder-email stamps (7 days / 2 days / on the deadline) so the
  /// in-process job never sends a reminder twice.
  reminder7SentAt   DateTime?
  reminder2SentAt   DateTime?
  reminderDueSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, deadline])
}

/// Skoðun / opið hús with attendees (SPEC §5 activity).
model Viewing {
  id        String      @id @default(cuid())
  tenantId  String
  listingId String
  listing   Listing     @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)
  kind      ViewingKind
  startsAt  DateTime
  endsAt    DateTime?
  note      String?

  createdById String?
  createdAt   DateTime @default(now())

  attendees ViewingAttendee[]

  // Composite target for the attendee FK
  @@unique([tenantId, id])
  @@index([tenantId, startsAt])
  @@index([tenantId, listingId])
}

model ViewingAttendee {
  id        String  @id @default(cuid())
  tenantId  String
  viewingId String
  viewing   Viewing @relation(fields: [tenantId, viewingId], references: [tenantId, id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [tenantId, contactId], references: [tenantId, id])

  @@unique([viewingId, contactId])
  @@index([tenantId, contactId])
}

/// Free-form note on a listing (SPEC §5 activity).
model ListingNote {
  id        String  @id @default(cuid())
  tenantId  String
  listingId String
  listing   Listing @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)

  body        String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, listingId, createdAt])
}

/// Task with due date and assignee (SPEC §5 activity).
model ListingTask {
  id        String  @id @default(cuid())
  tenantId  String
  listingId String
  listing   Listing @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)

  title          String
  dueDate        DateTime?
  assigneeUserId String?
  assignee       User?     @relation(fields: [tenantId, assigneeUserId], references: [tenantId, id])
  completedAt    DateTime?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, listingId])
  @@index([tenantId, assigneeUserId, completedAt])
  @@index([tenantId, completedAt, dueDate])
}
