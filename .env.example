# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://handsal:handsal@localhost:5432/handsal"
# Separate database used by the integration test suite (created automatically).
TEST_DATABASE_URL="postgresql://handsal:handsal@localhost:5432/handsal_test"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"
# Base URL of the app (used by Auth.js for callbacks).
AUTH_URL="http://localhost:3000"
# Set to "true" behind a reverse proxy in production.
AUTH_TRUST_HOST="true"

# ── Object storage (S3-compatible; MinIO in dev, R2/S3 in production) ──────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="handsal"
S3_SECRET_ACCESS_KEY="handsal-dev-secret"
S3_BUCKET="handsal"
# MinIO needs path-style URLs; set to "false" for AWS S3 / R2.
S3_FORCE_PATH_STYLE="true"

# ── Email (SMTP; Mailpit in dev) ────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Handsal <noreply@handsal.local>"

# ── E-signing webhook ───────────────────────────────────────────────────────
# Shared secret for POST /api/webhooks/signing (mock provider callbacks and,
# later, the real provider). Any non-empty value works in dev.
SIGNING_WEBHOOK_SECRET="handsal-dev-signing-secret"
# Set to "true" to expose dev tools (/dev/signing) outside NODE_ENV=development.
ALLOW_DEV_TOOLS="false"

# ── Adapters ────────────────────────────────────────────────────────────────
# Implementation selection for external integrations. Only "mock" exists today;
# real implementations are added when API agreements are signed (see SPEC §1.3).
ADAPTER_THJODSKRA="mock"
ADAPTER_BIFREIDASKRA="mock"
ADAPTER_PORTALS="mock"
ADAPTER_SIGNING="mock"
ADAPTER_EMAIL="smtp"
ADAPTER_PAYMENTS="stub"
